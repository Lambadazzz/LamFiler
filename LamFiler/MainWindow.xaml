<Window x:Class="LamFiler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Lambada" Height="600" Width="960"
        MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">

    <Window.Resources>
        <SolidColorBrush x:Key="BgPrimary"   Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#252526"/>
        <SolidColorBrush x:Key="BgHover"     Color="#2D2D2D"/>
        <SolidColorBrush x:Key="BgSelected"  Color="#094771"/>
        <SolidColorBrush x:Key="Border"      Color="#3C3C3C"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#858585"/>
        <SolidColorBrush x:Key="Accent"      Color="#0078D4"/>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width"  Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileRow" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    IsHitTestVisible="False"/>
                            <ContentPresenter VerticalAlignment="Stretch"/>
                            <Border Background="Transparent"
                                    IsHitTestVisible="True"
                                    Panel.ZIndex="99"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgSelected}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgSelected}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <!-- ══════════════ TAB BAR ══════════════ -->
        <Border Grid.Row="0" x:Name="TabBarBorder"
                Background="#161616"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                MouseMove="TabBar_MouseMove"
                MouseLeftButtonUp="TabBar_MouseLeftButtonUp">
            <Grid>
                <ScrollViewer x:Name="TabScroll"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="TabScroll_PreviewMouseWheel"
                              Margin="0,0,36,0">
                    <StackPanel x:Name="TabStrip" Orientation="Horizontal"
                                AllowDrop="True"
                                DragOver="TabStrip_DragOver"
                                Drop="TabStrip_Drop"/>
                </ScrollViewer>
                <Button x:Name="BtnNewTab" Click="BtnNewTab_Click"
                        Width="28" Height="22"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,4,0"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" ToolTip="Новая вкладка (Ctrl+T)"
                        Foreground="{StaticResource TextMuted}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                <TextBlock Text="+" FontSize="16" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Margin="0,-1,0,0"
                                           Foreground="{StaticResource TextMuted}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ══════════════ TOOLBAR ══════════════ -->
        <Border Grid.Row="1" Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Назад / Вперёд -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="BtnBack" Style="{StaticResource IconBtn}" Click="BtnBack_Click" IsEnabled="False" ToolTip="Назад">
                        <Path Data="M15 19 L8 12 L15 5" Stroke="{StaticResource TextMuted}"
                              StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="10" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnForward" Style="{StaticResource IconBtn}" Click="BtnForward_Click" IsEnabled="False" ToolTip="Вперёд">
                        <Path Data="M9 5 L16 12 L9 19" Stroke="{StaticResource TextMuted}"
                              StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="10" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <!-- Breadcrumb -->
                <Border Grid.Column="1" VerticalAlignment="Center"
                        Background="{StaticResource BgPrimary}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="4" Margin="0,0,8,0" Height="26">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="6,0">
                        <ItemsControl x:Name="Breadcrumb" VerticalAlignment="Center"
                                      AllowDrop="True"
                                      Drop="Breadcrumb_Drop"
                                      DragOver="Breadcrumb_DragOver"
                                      DragLeave="Breadcrumb_DragLeave"
                                      MouseUp="Breadcrumb_MouseUp">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding Label}" Tag="{Binding Path}"
                                                Click="BreadcrumbPart_Click"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{StaticResource TextMuted}"
                                                FontSize="12" Cursor="Hand" Padding="2,0"/>
                                        <TextBlock Text=" › " Foreground="{StaticResource TextMuted}"
                                                   FontSize="12" VerticalAlignment="Center" Opacity="0.5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Upload Drive -->
                <Border Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0"
                        BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Height="26">
                    <Button x:Name="BtnUploadDrive" Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextMuted}" FontSize="12"
                            Cursor="Hand" Padding="8,0" Click="BtnUploadDrive_Click"
                            ToolTip="Загрузить на Google Drive">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"
                                  Fill="#4285F4" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="Upload" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Кнопка переключения вида -->
                <Button x:Name="BtnViewToggle" Grid.Column="3"
                        Style="{StaticResource IconBtn}"
                        Click="BtnViewToggle_Click"
                        ToolTip="Переключить вид (Ctrl+1 — список, Ctrl+2 — сетка)"
                        Margin="0,0,4,0">
                    <Path x:Name="ViewToggleIcon"
                          Data="M3 3 H8 V8 H3 Z M10 3 H15 V8 H10 Z M3 10 H8 V15 H3 Z M10 10 H15 V15 H10 Z"
                          Fill="{StaticResource TextMuted}"
                          Width="14" Height="14" Stretch="Uniform"/>
                </Button>

                <!-- Поиск -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                            MouseEnter="SearchArea_MouseEnter" MouseLeave="SearchArea_MouseLeave">
                    <Border x:Name="SearchBorder"
                            Background="{StaticResource BgPrimary}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            CornerRadius="4" Height="26" Opacity="0" Width="0" ClipToBounds="True">
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimary}"
                                 CaretBrush="{StaticResource TextPrimary}"
                                 FontSize="12" Padding="6,0" VerticalContentAlignment="Center"
                                 MinWidth="160"
                                 TextChanged="SearchBox_TextChanged"
                                 KeyDown="SearchBox_KeyDown"
                                 LostFocus="SearchBox_LostFocus"/>
                    </Border>
                    <Button Style="{StaticResource IconBtn}" x:Name="BtnSearchToggle"
                            ToolTip="Поиск">
                        <Path Data="M21 21 L15.5 15.5 M17 11 A6 6 0 1 1 5 11 A6 6 0 1 1 17 11"
                              Stroke="{StaticResource TextMuted}"
                              StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════ BODY ══════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" MinWidth="120" MaxWidth="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="210" MinWidth="160" MaxWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource BgSecondary}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SidebarPanel" Margin="0,8,0,8"/>
                </ScrollViewer>
            </Border>

            <!-- Splitter 1 -->
            <GridSplitter Grid.Column="1" Width="4" Background="Transparent"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch" Cursor="SizeWE"/>

            <!-- Основная область -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовки колонок (list mode) -->
                <Border Grid.Row="0" x:Name="ListViewHeader" Background="{StaticResource BgSecondary}"
                        BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" x:Name="ColName" Click="ColHeader_Click" Tag="Name"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                HorizontalContentAlignment="Left" Padding="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Name" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ArrowName" Text="" Foreground="{StaticResource Accent}" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" x:Name="ColModified" Click="ColHeader_Click" Tag="Modified"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                HorizontalContentAlignment="Right" Padding="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ArrowModified" Text="" Foreground="{StaticResource Accent}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Modified" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" x:Name="ColSize" Click="ColHeader_Click" Tag="Size"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                HorizontalContentAlignment="Right" Padding="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ArrowSize" Text="" Foreground="{StaticResource Accent}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Size" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4" x:Name="ColType" Click="ColHeader_Click" Tag="Type"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                HorizontalContentAlignment="Right" Padding="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ArrowType" Text="" Foreground="{StaticResource Accent}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Type" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- List view -->
                <ListView x:Name="FileList" Grid.Row="1"
                          Background="{StaticResource BgPrimary}"
                          BorderThickness="0"
                          ItemContainerStyle="{StaticResource FileRow}"
                          MouseDoubleClick="FileList_MouseDoubleClick"
                          MouseUp="FileList_MouseButtonUp"
                          SelectionChanged="FileList_SelectionChanged"
                          MouseRightButtonDown="FileList_MouseRightButtonDown"
                          MouseRightButtonUp="FileList_MouseRightButtonUp"
                          PreviewKeyDown="FileList_PreviewKeyDown"
                          PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="FileList_PreviewMouseLeftButtonUp"
                          PreviewMouseMove="FileList_PreviewMouseMove"
                          AllowDrop="True"
                          DragOver="FileList_DragOver"
                          DragLeave="FileList_DragLeave"
                          Drop="FileList_Drop"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Opacity="{Binding Opacity}" VerticalAlignment="Stretch" Background="#01000000">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" x:Name="CheckZone"
                                        Background="#01000000"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Tag="checkbox">
                                    <Ellipse x:Name="CheckDot"
                                             Width="10" Height="10"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Fill="Transparent"
                                             Stroke="#555555" StrokeThickness="1.2"
                                             Opacity="0"/>
                                </Border>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" FontSize="14"
                                               Foreground="{Binding IconColor}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="NameLabel"
                                               Text="{Binding Name}" FontSize="13"
                                               Foreground="{StaticResource TextPrimary}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBox x:Name="NameEditor"
                                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="13" Padding="2,1"
                                             Background="#1E1E1E" Foreground="#CCCCCC"
                                             BorderBrush="#0078D4" BorderThickness="1"
                                             CaretBrush="#CCCCCC"
                                             Visibility="Collapsed"
                                             MinWidth="120"
                                             KeyDown="RenameBox_KeyDown"
                                             LostFocus="RenameBox_LostFocus"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Modified}" FontSize="12"
                                           Foreground="{StaticResource TextMuted}"
                                           TextAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding Size}" FontSize="12"
                                           Foreground="{StaticResource TextMuted}"
                                           TextAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="4" Text="{Binding TypeExt}" FontSize="12"
                                           Foreground="{StaticResource TextMuted}"
                                           TextAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                    <Setter TargetName="NameLabel"  Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="NameEditor" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                    <Setter TargetName="CheckDot" Property="Opacity" Value="1"/>
                                    <Setter TargetName="CheckDot" Property="Fill" Value="#0078D4"/>
                                    <Setter TargetName="CheckDot" Property="Stroke" Value="#0078D4"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                    <Setter TargetName="CheckDot" Property="Opacity" Value="0.5"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Grid view -->
                <ScrollViewer x:Name="GridViewScroll" Grid.Row="1"
                             Visibility="Collapsed"
                             AllowDrop="True"
                             Focusable="True"
                             Background="{StaticResource BgPrimary}"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseWheel="GridViewScroll_PreviewMouseWheel"
                             DragOver="GridViewScroll_DragOver"
                             DragLeave="GridViewScroll_DragLeave"
                             Drop="GridViewScroll_Drop">
                    <WrapPanel x:Name="GridViewPanel"
                               Orientation="Horizontal"
                               Margin="12,12,12,12"/>
                </ScrollViewer>

                <!-- Home page -->
                <Grid x:Name="HomePanel" Grid.Row="1"
                      Background="{StaticResource BgPrimary}"
                      Panel.ZIndex="10" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32,28,32,28">
                            <TextBlock Text="LamFiler" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,24"/>
                            <TextBlock Text="Быстрый доступ" FontSize="11" FontWeight="Medium"
                                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
                            <WrapPanel x:Name="HomeQuickPanel" Orientation="Horizontal" Margin="0,0,0,28"/>
                            <TextBlock Text="ДИСКИ" FontSize="11" FontWeight="Medium"
                                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
                            <WrapPanel x:Name="HomeDrivesPanel" Orientation="Horizontal"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Splitter 2 -->
            <GridSplitter Grid.Column="3" Width="4" Background="Transparent"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch" Cursor="SizeWE"/>

            <!-- Preview панель -->
            <Border Grid.Column="4" Background="{StaticResource BgSecondary}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="140"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#111111" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="UniformToFill" Opacity="0"/>
                            <TextBlock x:Name="PreviewIcon" Text="📄" FontSize="40"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMuted}"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PreviewMeta" Margin="12,10,12,10"/>
                        </ScrollViewer>

                        <StackPanel x:Name="PreviewActions" Grid.Row="1"
                                    Margin="10,0,10,10" Visibility="Collapsed">
                            <Border Height="0.5" Background="{StaticResource Border}" Margin="0,0,0,8"/>
                            <Button x:Name="BtnPreviewOpen" Click="BtnPreviewOpen_Click"
                                    Height="28" Margin="0,0,0,6"
                                    Background="{StaticResource Accent}"
                                    Foreground="White" BorderThickness="0"
                                    FontSize="12" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#1084D8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="▶  Открыть" FontSize="12"/>
                            </Button>
                            <Button x:Name="BtnPreviewOpenWith" Click="BtnPreviewOpenWith_Click"
                                    Height="28"
                                    Background="{StaticResource BgHover}"
                                    Foreground="{StaticResource TextMuted}"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    FontSize="12" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#3A3A3C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="🔧  Открыть с помощью..." FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════ STATUSBAR ══════════════ -->
        <Border Grid.Row="3" Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <TextBlock x:Name="StatusLeft" FontSize="11"
                           Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock x:Name="StatusRight" FontSize="11"
                           Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
