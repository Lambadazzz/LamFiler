<Window x:Class="LamFiler.RenameExtWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена расширения"
        Width="420" Height="230"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        Foreground="#CCCCCC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Иконка + заголовок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="⚠️" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock FontSize="14" FontWeight="Medium" Foreground="#CCCCCC"
                       VerticalAlignment="Center">
                Изменение расширения файла
            </TextBlock>
        </StackPanel>

        <!-- Текст -->
        <TextBlock x:Name="MessageText" Grid.Row="2"
                   FontSize="12" Foreground="#AAAAAA"
                   TextWrapping="Wrap"/>

        <!-- Галочка "Больше не спрашивать" -->
        <CheckBox x:Name="ChkDontAsk" Grid.Row="4"
                  Content="Больше не спрашивать  (можно изменить в настройках)"
                  FontSize="12" Foreground="#858585">
            <CheckBox.Resources>
                <Style TargetType="CheckBox">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="CheckBox">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="Box" Width="15" Height="15"
                                            Background="#2D2D2D"
                                            BorderBrush="#3C3C3C" BorderThickness="1"
                                            CornerRadius="3" Margin="0,0,8,0"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="Check" Text="✓"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="#0078D4"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                    </Border>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Box" Property="BorderBrush" Value="#0078D4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </CheckBox.Resources>
        </CheckBox>

        <!-- Кнопки -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="Отмена"
                    Width="80" Height="28" Margin="0,0,8,0"
                    Click="BtnCancel_Click"
                    Background="#2D2D2D" Foreground="#CCCCCC"
                    BorderBrush="#3C3C3C" BorderThickness="1" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A3A3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="BtnConfirm" Content="✏  Переименовать"
                    Width="140" Height="28"
                    Click="BtnConfirm_Click"
                    Background="#0078D4" Foreground="White"
                    BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1084D8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
