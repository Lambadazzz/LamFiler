<Window x:Class="LamFiler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Lambada" Height="600" Width="960"
        MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">

    <Window.Resources>
        <SolidColorBrush x:Key="BgPrimary"   Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#252526"/>
        <SolidColorBrush x:Key="BgHover"     Color="#2D2D2D"/>
        <SolidColorBrush x:Key="BgSelected"  Color="#094771"/>
        <SolidColorBrush x:Key="Border"      Color="#3C3C3C"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#858585"/>
        <SolidColorBrush x:Key="Accent"      Color="#0078D4"/>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width"  Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileRow" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <!-- ══════════════ TOOLBAR ══════════════ -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="BtnBack" Style="{StaticResource IconBtn}" Click="BtnBack_Click" IsEnabled="False" ToolTip="Назад">
                        <Path Data="M15 19 L8 12 L15 5" Stroke="{StaticResource TextMuted}"
                              StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="10" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnForward" Style="{StaticResource IconBtn}" Click="BtnForward_Click" IsEnabled="False" ToolTip="Вперёд">
                        <Path Data="M9 5 L16 12 L9 19" Stroke="{StaticResource TextMuted}"
                              StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="10" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <Border Grid.Column="1" VerticalAlignment="Center"
                        Background="{StaticResource BgPrimary}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="4" Margin="0,0,8,0" Height="26">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="6,0">
                        <ItemsControl x:Name="Breadcrumb" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding Label}" Tag="{Binding Path}"
                                                Click="BreadcrumbPart_Click"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{StaticResource TextMuted}"
                                                FontSize="12" Cursor="Hand" Padding="2,0"/>
                                        <TextBlock Text=" › " Foreground="{StaticResource TextMuted}"
                                                   FontSize="12" VerticalAlignment="Center" Opacity="0.5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0"
                        BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Height="26">
                    <Button x:Name="BtnUploadDrive" Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextMuted}" FontSize="12"
                            Cursor="Hand" Padding="8,0" Click="BtnUploadDrive_Click"
                            ToolTip="Загрузить на Google Drive">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"
                                  Fill="#4285F4" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="Upload" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                            MouseEnter="SearchArea_MouseEnter" MouseLeave="SearchArea_MouseLeave">
                    <Border x:Name="SearchBorder"
                            Background="{StaticResource BgPrimary}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            CornerRadius="4" Height="26" Opacity="0" Width="0" ClipToBounds="True">
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimary}"
                                 CaretBrush="{StaticResource TextPrimary}"
                                 FontSize="12" Padding="6,0" VerticalContentAlignment="Center"
                                 MinWidth="160"
                                 TextChanged="SearchBox_TextChanged"
                                 KeyDown="SearchBox_KeyDown"
                                 LostFocus="SearchBox_LostFocus"/>
                    </Border>
                    <Button Style="{StaticResource IconBtn}" x:Name="BtnSearchToggle"
                            ToolTip="Поиск">
                        <Path Data="M21 21 L15.5 15.5 M17 11 A6 6 0 1 1 5 11 A6 6 0 1 1 17 11"
                              Stroke="{StaticResource TextMuted}"
                              StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════ BODY ══════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" MinWidth="120" MaxWidth="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="210" MinWidth="160" MaxWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource BgSecondary}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SidebarPanel" Margin="0,8,0,8"/>
                </ScrollViewer>
            </Border>

            <!-- Splitter 1 -->
            <GridSplitter Grid.Column="1" Width="4" Background="Transparent"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch" Cursor="SizeWE"/>

            <!-- Основная область -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BgSecondary}"
                        BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Name" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Modified" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="Size" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="Type" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>
                    </Grid>
                </Border>

                <ListView x:Name="FileList" Grid.Row="1"
                          Background="{StaticResource BgPrimary}"
                          BorderThickness="0"
                          ItemContainerStyle="{StaticResource FileRow}"
                          MouseDoubleClick="FileList_MouseDoubleClick"
                          SelectionChanged="FileList_SelectionChanged"
                          MouseRightButtonDown="FileList_MouseRightButtonDown"
                          MouseRightButtonUp="FileList_MouseRightButtonUp"
                          PreviewKeyDown="FileList_PreviewKeyDown"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Opacity="{Binding Opacity}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="14"
                                               Foreground="{Binding IconColor}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                               Foreground="{StaticResource TextPrimary}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Modified}" FontSize="12"
                                           Foreground="{StaticResource TextMuted}"
                                           TextAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Size}" FontSize="12"
                                           Foreground="{StaticResource TextMuted}"
                                           TextAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding TypeExt}" FontSize="12"
                                           Foreground="{StaticResource TextMuted}"
                                           TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Splitter 2 -->
            <GridSplitter Grid.Column="3" Width="4" Background="Transparent"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch" Cursor="SizeWE"/>

            <!-- Preview панель (правая, постоянная) -->
            <Border Grid.Column="4" Background="{StaticResource BgSecondary}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="140"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#111111" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="UniformToFill" Opacity="0"/>
                            <TextBlock x:Name="PreviewIcon" Text="📄" FontSize="40"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMuted}"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PreviewMeta" Margin="12,10,12,10"/>
                        </ScrollViewer>

                        <StackPanel x:Name="PreviewActions" Grid.Row="1"
                                    Margin="10,0,10,10" Visibility="Collapsed">
                            <Border Height="0.5" Background="{StaticResource Border}" Margin="0,0,0,8"/>
                            <Button x:Name="BtnPreviewOpen" Click="BtnPreviewOpen_Click"
                                    Height="28" Margin="0,0,0,6"
                                    Background="{StaticResource Accent}"
                                    Foreground="White" BorderThickness="0"
                                    FontSize="12" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#1084D8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="▶  Открыть" FontSize="12"/>
                            </Button>
                            <Button x:Name="BtnPreviewOpenWith" Click="BtnPreviewOpenWith_Click"
                                    Height="28"
                                    Background="{StaticResource BgHover}"
                                    Foreground="{StaticResource TextMuted}"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    FontSize="12" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#3A3A3C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="🔧  Открыть с помощью..." FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

        </Grid>

        <!-- ══════════════ STATUSBAR ══════════════ -->
        <Border Grid.Row="2" Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <TextBlock x:Name="StatusLeft" FontSize="11"
                           Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock x:Name="StatusRight" FontSize="11"
                           Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
