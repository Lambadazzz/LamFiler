<Window x:Class="LamFiler.DeleteConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Удаление"
        Width="380" Height="170"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        Foreground="#CCCCCC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Иконка + заголовок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="🗑" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock x:Name="TitleText" FontSize="14" FontWeight="Medium"
                       Foreground="#CCCCCC" VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Подзаголовок -->
        <TextBlock x:Name="SubText" Grid.Row="2"
                   Text="Это действие нельзя отменить."
                   FontSize="12" Foreground="#858585"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="Отмена"
                    Width="80" Height="28" Margin="0,0,8,0"
                    Click="BtnCancel_Click"
                    Background="#2D2D2D" Foreground="#CCCCCC"
                    BorderBrush="#3C3C3C" BorderThickness="1" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A3A3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="BtnDelete" Content="🗑  Удалить"
                    Width="100" Height="28"
                    Click="BtnDelete_Click"
                    Background="#C0392B" Foreground="White"
                    BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E74C3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
